{
  "manifest_version": 3,
  "name": "GIF Frame Master",
  "version": "1.1",
  "description": "Advanced GIF editor: multi-frame removal, visual crop, frame reordering, GIF appending and custom export.",
  "action": {
    "default_title": "Open GIF Frame Master",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ]
}